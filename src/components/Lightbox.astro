---
// Full-screen photo viewer. Any element with data-full (full-size image URL) and data-alt on the page opens it;
// it pages through all of them in page order, in a loop (buttons, arrow keys or swipe).
---
<dialog class="lb" data-lb aria-label="Photo viewer">
  <img alt="" data-lb-img />
  <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous photo"><span class="material-symbols-outlined">chevron_left</span></button>
  <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next photo"><span class="material-symbols-outlined">chevron_right</span></button>
  <div class="lb__bar"><span class="lb__count" data-lb-count></span><span class="lb__cap" data-lb-cap></span></div>
  <button class="lb__close btn btn--ghost" type="button" data-lb-close>Close</button>
</dialog>

<script>
  // Lightbox: click a photo to open it, then page through all of them in a loop
  // (buttons, arrow keys or swipe). The next and previous photos are preloaded.
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
  const cap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-full]')];
  let at = 0;
  const preload = (i: number) => { new Image().src = items[(i + items.length) % items.length].dataset.full!; };
  const show = (i: number) => {
    at = (i + items.length) % items.length;
    const b = items[at];
    img.src = b.dataset.full!;
    img.alt = b.dataset.alt || '';
    cap.textContent = (b.dataset.alt || '').replace(/^Lewis Smart #32, /, '');
    count.textContent = `${at + 1} / ${items.length}`;
    preload(at + 1); preload(at - 1);
  };
  items.forEach((b, i) => b.addEventListener('click', () => { show(i); lb.showModal(); }));
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(at - 1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(at + 1));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); show(at - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); show(at + 1); }
  });
  let x0: number | null = null;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0; x0 = null;
    if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .lb { max-width: 96vw; max-height: 94vh; padding: 0; overflow: hidden; border: 1px solid var(--accent-line); background: var(--surface-inset); }
  .lb::backdrop { background: rgb(7 7 9 / .95); backdrop-filter: blur(16px); }
  .lb img { display: block; max-width: 96vw; max-height: 94vh; object-fit: contain; user-select: none; }
  .lb__close { position: absolute; top: .75rem; right: .75rem; background: rgb(0 0 0 / .6); }
  .lb__nav { position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 48px; height: 64px; border: 0; background: rgb(0 0 0 / .55); color: #fff; cursor: pointer; transition: background-color .2s, color .2s; }
  .lb__nav:hover, .lb__nav:focus-visible { background: var(--accent); color: var(--on-accent); }
  .lb__nav .material-symbols-outlined { font-size: 36px; }
  .lb__nav--prev { left: 0; }
  .lb__nav--next { right: 0; }
  .lb__bar { position: absolute; left: 0; top: 0; display: flex; gap: .75rem; align-items: baseline; padding: .9rem 1rem; max-width: calc(100% - 7rem); font-family: var(--font-display); font-weight: 800; font-style: italic; text-transform: uppercase; letter-spacing: .06em; color: #fff; text-shadow: 0 1px 6px rgb(0 0 0 / .8); }
  .lb__count { color: var(--accent); white-space: nowrap; }
  .lb__cap { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
