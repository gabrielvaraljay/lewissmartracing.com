---
import { site } from '../data/site';
import Icon from './Icon.astro';
interface Props { heading?: string }
const { heading = 'Put your brand on #32' } = Astro.props;
---
<div class="cta card--chamfer" data-reveal>
  <span class="watermark" style="font-size: 26rem; right: -2rem; bottom: -7rem; opacity: .07;">32</span>
  <div class="cta__body">
    <div class="kicker"><span class="label">Partnership</span></div>
    <h2 class="h-xl">{heading}</h2>
    <p class="lead">A young British racer on the rise, backed by Triumph, with a growing following on and off track. Partners get real visibility on the bike, the leathers and across social channels, plus a story worth being part of.</p>
  </div>
  <div class="btn-row">
    {site.sponsorDeck
      ? <a class="btn btn--primary" href={site.sponsorDeck} download>Download sponsorship deck <span class="arrow"><Icon name="download" size={18} /></span></a>
      : <a class="btn btn--primary" href="/contact/?topic=sponsorship">Request the sponsorship deck <span class="arrow"><Icon name="arrow" size={18} /></span></a>}
    <a class="btn btn--ghost" href="/contact/?topic=sponsorship">Talk to us</a>
  </div>
</div>

<style>
  .cta { position: relative; overflow: hidden; display: grid; gap: 2rem; padding: clamp(2rem, 5vw, 3.5rem);
    background: linear-gradient(120deg, var(--surface-hi), var(--surface) 55%, var(--surface-inset));
    border-left: 4px solid var(--accent); }
  .cta__body { position: relative; display: grid; gap: 1rem; }
  .cta__body .kicker { margin: 0; }
  .cta .lead { margin: 0; }
  .cta .btn-row { position: relative; }
  @media (min-width: 1000px) { .cta { grid-template-columns: 1.6fr 1fr; align-items: end; } .cta .btn-row { justify-content: flex-end; } }
</style>
