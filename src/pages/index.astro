<script>
  // Scroll-driven hero: progress bar + optional frame flip-book on the canvas.
  const container = document.getElementById('hero-scroll-container');
  const bar = document.getElementById('scroll-progress-bar');
  const canvas = document.getElementById('hero-scrub-canvas') as HTMLCanvasElement | null;
  const count = Number(container?.dataset.frames || 0);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 640px)').matches;

  if (container) {
    const frames: HTMLImageElement[] = [];
    const ctx = canvas?.getContext('2d') ?? null;
    let current = -1;
    const useFrames = !!(canvas && ctx && count > 0 && !reduce && wide);

    const progress = () => {
      const r = container.getBoundingClientRect();
      const span = Math.max(1, container.offsetHeight - innerHeight);
      return Math.min(1, Math.max(0, -r.top / span));
    };
    const drawFrame = (i: number) => {
      if (!canvas || !ctx) return;
      let img = frames[i];
      for (let k = i; (!img || !img.complete || !img.naturalWidth) && k >= 0; k--) img = frames[k];
      if (!img || !img.naturalWidth) return;
      const s = Math.max(canvas.width / img.naturalWidth, canvas.height / img.naturalHeight);
      const w = img.naturalWidth * s, h = img.naturalHeight * s;
      ctx.drawImage(img, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h);
      canvas.classList.remove('opacity-0');
    };
    const update = () => {
      const p = progress();
      if (bar) bar.style.width = `${p * 100}%`;
      if (useFrames) {
        const i = Math.min(count - 1, Math.floor(p * count));
        if (i !== current) { current = i; drawFrame(i); }
      }
    };
    const resize = () => {
      if (!canvas) return;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = canvas.clientWidth * dpr;
      canvas.height = canvas.clientHeight * dpr;
      current = -1;
      update();
    };

    if (useFrames) {
      for (let i = 1; i <= count; i++) {
        const img = new Image();
        img.decoding = 'async';
        img.src = `/frames/frame-${String(i).padStart(2, '0')}.webp`;
        if (i === 1) img.onload = () => { current = -1; update(); };
        frames.push(img);
      }
      addEventListener('resize', resize);
      resize();
    }
    let ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    }, { passive: true });
    update();
  }

  // Next race countdown (only runs when a race date is set in src/data/site.ts).
  const cd = document.querySelector<HTMLElement>('[data-countdown]');
  const target = cd?.dataset.countdown ? new Date(cd.dataset.countdown).getTime() : NaN;
  if (cd && !Number.isNaN(target)) {
    const els = ['days', 'hours', 'mins', 'secs'].map((id) => document.getElementById(`countdown-${id}`)!);
    const tick = () => {
      let s = Math.max(0, Math.floor((target - Date.now()) / 1000));
      const v = [Math.floor(s / 86400), Math.floor((s %= 86400) / 3600), Math.floor((s %= 3600) / 60), s % 60];
      v.forEach((n, i) => (els[i].textContent = String(n).padStart(2, '0')));
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
