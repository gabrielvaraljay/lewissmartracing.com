---
// Home page. Layout ported 1:1 from the Google Stitch design; copy limited to confirmed facts.
import Base from '../layouts/Base.astro';
import { heroFrameCount, nextRace, site, sponsors, stats } from '../data/site';

const heroStatic = heroFrameCount > 0 ? '/frames/frame-01.webp' : '/images/hero-static.webp';
const race = nextRace;
const raceDate = race ? new Date(race.date) : null;
// Names visible on the 2025 bike and leathers. Replace with logo files once supplied and confirmed.
const partnerNames = sponsors.length ? sponsors.map((s) => s.name) : ['BAS Group', 'Amethyst', 'Byrne Electrical', 'On Point Technology', 'RST', 'Arai'];
const socialTiles = [
  { src: '/images/hero-static.webp', alt: 'Lewis Smart cornering on the number 32 bike' },
  { src: '/images/lewis-grid.webp', alt: 'Lewis Smart on the grid' },
  { src: '/images/bike-livery.webp', alt: 'Close-up of the number 32 livery' },
  null,
];
---
<Base>
  <div class="flex flex-col w-full bg-surface-container-lowest text-on-surface">
    <!-- 1. HERO: SCROLL-DRIVEN FLIP-BOOK -->
    <section class="relative w-full h-[100svh] sm:h-[300vh] bg-surface-container-lowest" id="hero-scroll-container" data-frames={heroFrameCount}>
      <div class="sticky top-0 h-screen w-full overflow-hidden flex flex-col justify-between">
        <div class="absolute inset-0 z-0">
          <img class="absolute inset-0 w-full h-full object-cover object-[36%_50%] sm:object-center" src={heroStatic} alt="Lewis Smart racing the number 32 bike" fetchpriority="high" decoding="async" />
          <canvas class="absolute inset-0 w-full h-full object-cover hidden sm:block opacity-0 transition-opacity duration-500" id="hero-scrub-canvas" aria-hidden="true"></canvas>
          <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/60 to-surface-container-lowest/30"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-surface-container-lowest/90 via-surface-container-lowest/40 to-transparent"></div>
          <div class="pointer-events-none select-none absolute -right-12 top-1/4 opacity-[0.04] font-display-hero text-[260px] lg:text-[420px] font-black italic tracking-tighter text-on-surface leading-none" aria-hidden="true">#32</div>
          <div class="absolute inset-0 pointer-events-none opacity-20 bg-[linear-gradient(to_right,rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
        </div>
        <!-- Top bar -->
        <div class="relative z-10 w-full pt-6 px-margin-sm lg:px-margin max-w-7xl mx-auto flex items-center justify-between">
          <div class="flex items-center gap-space-sm bg-surface-container/80 backdrop-blur-md px-space-md py-space-xs rounded-full">
            <span class="w-2.5 h-2.5 rounded-full bg-primary-container animate-pulse"></span>
            <span class="font-label-xs text-label-xs uppercase tracking-widest text-on-surface">#32 // Official Site</span>
          </div>
          <div class="hidden md:flex items-center gap-space-md font-label-xs text-label-xs uppercase tracking-widest text-on-surface-variant bg-surface-container/60 backdrop-blur-md px-space-md py-space-xs rounded-full">
            <span>Racing with Triumph</span>
            <span class="text-primary-container">/</span>
            <span>British Road Racer</span>
          </div>
        </div>
        <!-- Headline -->
        <div class="relative z-10 w-full px-margin-sm lg:px-margin max-w-7xl mx-auto my-auto flex flex-col justify-center">
          <div class="flex items-center gap-space-xs mb-space-xs">
            <span class="px-space-sm py-0.5 bg-primary-container text-on-primary-container font-headline-sm text-headline-sm uppercase italic tracking-wider">Official Site</span>
            <span class="font-label-md text-label-md uppercase tracking-widest text-primary-container font-bold">Rider #32</span>
          </div>
          <div class="flex flex-col">
            <h1 class="font-display-hero text-[64px] sm:text-[96px] lg:text-[132px] leading-none uppercase italic font-black text-on-surface tracking-tighter drop-shadow-2xl">LEWIS SMART</h1>
            <div class="flex flex-wrap items-baseline gap-x-space-md gap-y-1 -mt-2 sm:-mt-4">
              <span class="font-display-hero text-[48px] sm:text-[84px] leading-none italic font-black text-primary-container tracking-tight">#32</span>
              <span class="font-headline-lg text-[22px] sm:text-headline-lg uppercase italic font-bold tracking-tight text-on-surface-variant">{site.tagline}</span>
            </div>
          </div>
          <!-- Data strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm max-w-3xl mt-space-lg">
            <div class="bg-surface-container-high/80 backdrop-blur-md p-space-sm">
              <span class="block font-label-xs text-label-xs uppercase text-on-surface-variant">First Season</span>
              <div class="flex items-baseline gap-1 mt-0.5"><span class="font-telemetry-num text-telemetry-num font-black text-on-surface">2020</span><span class="font-label-xs text-label-xs text-primary-container uppercase">CB500</span></div>
            </div>
            <div class="bg-surface-container-high/80 backdrop-blur-md p-space-sm">
              <span class="block font-label-xs text-label-xs uppercase text-on-surface-variant">Championship</span>
              <div class="flex items-baseline gap-1 mt-0.5"><span class="font-telemetry-num text-telemetry-num font-black text-on-surface">2022</span><span class="font-label-xs text-label-xs text-primary-container uppercase">Title</span></div>
            </div>
            <div class="bg-surface-container-high/80 backdrop-blur-md p-space-sm">
              <span class="block font-label-xs text-label-xs uppercase text-on-surface-variant">2024 Finish</span>
              <div class="flex items-baseline gap-1 mt-0.5"><span class="font-telemetry-num text-telemetry-num font-black text-on-surface">P3</span><span class="font-label-xs text-label-xs text-primary-container uppercase">Overall</span></div>
            </div>
            <div class="bg-surface-container-high/80 backdrop-blur-md p-space-sm">
              <span class="block font-label-xs text-label-xs uppercase text-on-surface-variant">Target Pos</span>
              <div class="flex items-baseline gap-1 mt-0.5"><span class="font-telemetry-num text-telemetry-num font-black text-primary-container">P1</span><span class="font-label-xs text-label-xs text-on-surface-variant uppercase">Podium</span></div>
            </div>
          </div>
        </div>
        <!-- Scroll indicator -->
        <div class="relative z-10 w-full pb-space-lg px-margin-sm lg:px-margin max-w-7xl mx-auto flex items-center justify-between">
          <div class="flex items-center gap-space-sm">
            <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center animate-bounce">
              <span class="material-symbols-outlined text-primary-container text-[20px]">keyboard_double_arrow_down</span>
            </div>
            <div class="flex flex-col">
              <span class="font-label-xs text-label-xs uppercase tracking-widest text-on-surface font-bold">Scroll to accelerate</span>
              <span class="font-body-sm text-[11px] text-on-surface-variant uppercase">From Freshman to factory Triumph</span>
            </div>
          </div>
          <div class="hidden sm:flex items-center gap-space-sm">
            <span class="font-label-xs text-label-xs uppercase tracking-wider text-on-surface-variant">Timing line</span>
            <div class="w-32 h-1.5 bg-surface-container-high rounded-full overflow-hidden">
              <div class="h-full bg-primary-container w-0" id="scroll-progress-bar"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. ABOUT TEASER -->
    <section class="relative w-full py-space-xl bg-surface-container-lowest overflow-hidden" id="about">
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
          <div class="lg:col-span-5 relative group">
            <div class="absolute -inset-2 bg-gradient-to-tr from-primary-container/20 to-transparent -skew-y-2 rounded-xl blur-lg transition duration-500 group-hover:from-primary-container/40"></div>
            <div class="relative bg-surface-container rounded-lg overflow-hidden shadow-2xl">
              <div class="relative aspect-[3/4] overflow-hidden">
                <img alt="Portrait of Lewis Smart behind the screen of his number 32 bike" class="w-full h-full object-cover object-top transition duration-700 group-hover:scale-105" src="/images/lewis-portrait.webp" width="540" height="720" loading="lazy" decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container via-transparent to-transparent"></div>
                <span class="pointer-events-none absolute right-2 bottom-4 font-display-hero text-8xl font-black italic text-on-surface/10 select-none">#32</span>
              </div>
              <div class="p-space-md bg-surface-container-high flex flex-col gap-space-xs">
                <div class="flex items-center justify-between">
                  <span class="font-label-xs text-label-xs uppercase tracking-widest text-primary-container font-bold">Race Discipline</span>
                  <span class="font-label-xs text-label-xs uppercase tracking-widest text-on-surface-variant">Road Racing</span>
                </div>
                <div class="font-headline-sm text-headline-sm uppercase text-on-surface tracking-wide">Silverstone Motorsport College Race Technician</div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-7 flex flex-col gap-space-md">
            <div class="flex items-center gap-space-xs">
              <span class="h-0.5 w-10 bg-primary-container"></span>
              <span class="font-label-xs text-label-xs uppercase tracking-widest text-primary-container font-black">Origin &amp; Drive</span>
            </div>
            <h2 class="font-headline-xl text-headline-xl-mobile sm:text-[56px] sm:leading-[60px] uppercase italic font-black text-on-surface tracking-tight leading-tight">
              BUILT TO RACE:<br /><span class="text-primary-container">CIRCUIT SPEED</span> MEETS TECHNICAL PRECISION
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
              Lewis Smart started racing in 2020 after training as a race technician at Silverstone Motorsport College, where a racing classmate got him hooked. He understands the bike as well as he rides it.
            </p>
            <p class="font-body-md text-body-md text-on-surface-variant/90 leading-relaxed">
              Every season since has been a step up: the Sportsman title, a first Junior Supersport win, two endurance championships and 3rd in the 2024 British Superteens. That form earned him a factory ride with Macadam Triumph Factory Racing in the National Sportbike Championship.
            </p>
            <div class="grid grid-cols-2 gap-space-sm pt-space-xs">
              <div class="p-space-sm bg-surface-container-low rounded">
                <div class="flex items-center gap-space-xs text-primary-container mb-1">
                  <span class="material-symbols-outlined text-[20px]">construction</span>
                  <span class="font-label-md text-label-md uppercase font-bold text-on-surface">Mechanical Insight</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Trained race technician who speaks the same language as his crew.</p>
              </div>
              <div class="p-space-sm bg-surface-container-low rounded">
                <div class="flex items-center gap-space-xs text-primary-container mb-1">
                  <span class="material-symbols-outlined text-[20px]">fitness_center</span>
                  <span class="font-label-md text-label-md uppercase font-bold text-on-surface">5-Day Regimen</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">In the gym five days a week to stay sharp for every race weekend.</p>
              </div>
            </div>
            <div class="pt-space-sm flex flex-wrap items-center gap-space-md">
              <a class="inline-flex items-center gap-space-xs px-space-lg py-space-sm bg-primary-container hover:bg-primary text-on-primary-container font-headline-sm text-headline-sm uppercase italic tracking-wider transition-all shadow-lg shadow-primary-container/20 hover:scale-[1.02]" href="/my-story/">
                <span>Read My Full Story</span><span class="material-symbols-outlined text-[20px]">arrow_forward</span>
              </a>
              <a class="inline-flex items-center gap-space-xs px-space-md py-space-sm bg-surface-container-high hover:bg-surface-variant text-on-surface font-headline-sm text-headline-sm uppercase italic tracking-wide transition-all" href="/bike-and-team/">
                <span>View the Bike</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. STATS STRIP -->
    <section class="w-full bg-surface-container-low py-space-lg">
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-space-md">
          {[
            { kicker: 'Experience', icon: 'timer', value: stats[0].value, label: 'Seasons Raced', hot: false },
            { kicker: 'Checkered Flags', icon: 'sports_score', value: stats[1].value, label: 'Career Race Wins', hot: true },
            { kicker: 'Podiums', icon: 'military_tech', value: stats[2].value, label: 'Podium Finishes', hot: false },
            { kicker: 'Championship Honours', icon: 'trophy', value: stats[3].value, label: 'Titles (2022 to 2024)', hot: false },
          ].map((m) => (
            <div class="relative bg-surface-container p-space-md rounded-lg overflow-hidden group hover:bg-surface-container-high transition-all">
              <div class="absolute top-0 right-0 w-24 h-24 bg-primary-container/5 rounded-full blur-2xl group-hover:bg-primary-container/15 transition-all"></div>
              <div class="flex items-center justify-between mb-space-xs">
                <span class="font-label-xs text-label-xs uppercase tracking-widest text-on-surface-variant">{m.kicker}</span>
                <span class="material-symbols-outlined text-primary-container text-[18px]">{m.icon}</span>
              </div>
              <div class:list={['font-display-hero text-headline-xl font-black italic leading-none mb-1', m.value ? (m.hot ? 'text-primary-container' : 'text-on-surface') : 'text-on-surface-variant/50']}>{m.value ?? 'TBC'}</div>
              <div class="font-label-md text-label-md uppercase tracking-wider text-on-surface-variant">{m.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. KEY MILESTONES -->
    <section class="w-full py-space-xl bg-surface-container-lowest relative">
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-space-md mb-space-xl">
          <div>
            <div class="flex items-center gap-space-xs mb-space-xs">
              <span class="h-0.5 w-8 bg-primary-container"></span>
              <span class="font-label-xs text-label-xs uppercase tracking-widest text-primary-container font-black">Chronology</span>
            </div>
            <h2 class="font-headline-lg text-headline-lg-mobile sm:text-headline-lg uppercase italic font-black text-on-surface tracking-tight">ACCELERATED MILESTONES</h2>
          </div>
          <a class="inline-flex items-center gap-space-xs font-label-md text-label-md uppercase tracking-widest text-primary-container hover:text-on-surface transition-colors" href="/my-story/">
            <span>Explore Complete Career Timeline</span><span class="material-symbols-outlined text-[16px]">chevron_right</span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
          <div class="bg-surface-container-low rounded-lg p-space-lg flex flex-col justify-between relative overflow-hidden group hover:shadow-2xl hover:shadow-primary-container/10 transition-all duration-300">
            <div class="absolute -top-12 -right-12 font-display-hero text-8xl font-black italic text-on-surface/5 group-hover:text-primary-container/10 transition-colors">20</div>
            <div>
              <div class="flex items-center justify-between mb-space-md">
                <span class="px-space-sm py-1 bg-surface-container-high text-on-surface font-headline-sm text-headline-sm uppercase italic">2020 SEASON</span>
                <span class="font-label-xs text-label-xs uppercase tracking-widest text-primary-container font-bold">Rookie Year</span>
              </div>
              <h3 class="font-headline-md text-headline-md uppercase italic font-black text-on-surface mb-space-sm leading-tight">Freshman Championship Podium</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md">A debut season on a Honda CB500 through a COVID-delayed calendar. Several race wins and 3rd overall in the Freshman Championship.</p>
            </div>
            <div class="pt-space-md flex items-center justify-between text-on-surface-variant font-label-xs text-label-xs uppercase tracking-widest">
              <span>Machine: Honda CB500</span><span class="text-primary-container font-bold">P3 Final Standings</span>
            </div>
          </div>
          <div class="bg-surface-container rounded-lg p-space-lg flex flex-col justify-between relative overflow-hidden group hover:shadow-2xl hover:shadow-primary-container/20 transition-all duration-300">
            <div class="absolute -top-12 -right-12 font-display-hero text-8xl font-black italic text-primary-container/10 group-hover:text-primary-container/20 transition-colors">22</div>
            <div>
              <div class="flex items-center justify-between mb-space-md">
                <span class="px-space-sm py-1 bg-primary-container text-on-primary-container font-headline-sm text-headline-sm uppercase italic font-bold">2022 CHAMPION</span>
                <span class="font-label-xs text-label-xs uppercase tracking-widest text-tertiary font-bold">Title Secured</span>
              </div>
              <h3 class="font-headline-md text-headline-md uppercase italic font-black text-on-surface mb-space-sm leading-tight">Sportsman Title &amp; Junior Supersport</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md">Crowned Sportsman Champion, while also lining up in British Superbikes Junior Supersport against the best young riders in the country.</p>
            </div>
            <div class="pt-space-md flex items-center justify-between text-on-surface-variant font-label-xs text-label-xs uppercase tracking-widest">
              <span>Sportsman Championship</span><span class="text-primary-container font-bold">Champion Title</span>
            </div>
          </div>
          <div class="bg-surface-container-low rounded-lg p-space-lg flex flex-col justify-between relative overflow-hidden group hover:shadow-2xl hover:shadow-primary-container/10 transition-all duration-300">
            <div class="absolute -top-12 -right-12 font-display-hero text-8xl font-black italic text-on-surface/5 group-hover:text-primary-container/10 transition-colors">25</div>
            <div>
              <div class="flex items-center justify-between mb-space-md">
                <span class="px-space-sm py-1 bg-surface-container-high text-on-surface font-headline-sm text-headline-sm uppercase italic">2025 TRIUMPH</span>
                <span class="font-label-xs text-label-xs uppercase tracking-widest text-primary-container font-bold">Present Era</span>
              </div>
              <h3 class="font-headline-md text-headline-md uppercase italic font-black text-on-surface mb-space-sm leading-tight">Racing with Triumph</h3>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md">After 3rd in the 2024 British Superteens on a Kawasaki ZX-4RR and the National 600 Endurance title, Lewis joined Macadam Triumph Factory Racing. His debut National Sportbike season closed with a season-best 5th at Brands Hatch.</p>
            </div>
            <div class="pt-space-md flex items-center justify-between text-on-surface-variant font-label-xs text-label-xs uppercase tracking-widest">
              <span>Machine: Daytona 660</span><span class="text-primary-container font-bold">Championship Hunt</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. NEXT RACE COUNTDOWN -->
    <section class="w-full py-space-xl bg-surface-container-low relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin relative z-10">
        <div class="bg-surface-container rounded-xl p-space-lg lg:p-space-xl relative overflow-hidden shadow-2xl">
          <div class="absolute right-0 top-0 bottom-0 w-1/2 bg-gradient-to-l from-primary-container/10 to-transparent pointer-events-none"></div>
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
            <div class="lg:col-span-6 flex flex-col gap-space-sm relative">
              <div class="flex flex-wrap items-center gap-space-xs">
                <span class="px-space-sm py-0.5 bg-primary-container text-on-primary-container font-label-xs text-label-xs uppercase font-bold tracking-widest">{race ? `${race.round} on deck` : 'Next round'}</span>
                <span class="font-label-xs text-label-xs uppercase tracking-widest text-on-surface-variant">{race ? race.series : 'Season calendar'}</span>
              </div>
              <h3 class="font-headline-xl text-headline-xl-mobile sm:text-[54px] sm:leading-[56px] uppercase italic font-black text-on-surface tracking-tight leading-none">{race ? race.circuit : 'CALENDAR COMING SOON'}</h3>
              <p class="font-body-md text-body-md text-on-surface-variant">
                {race ? `Race weekend: ${raceDate!.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}.` : 'The next round and its countdown will appear here as soon as the season calendar is confirmed.'}
              </p>
              <div class="grid grid-cols-3 gap-space-xs pt-space-xs">
                <div class="bg-surface-container-high p-space-xs rounded">
                  <span class="block font-label-xs text-[10px] text-on-surface-variant uppercase">Round</span>
                  <span class="font-headline-sm text-headline-sm italic text-on-surface font-bold">{race ? race.round : 'TBC'}</span>
                </div>
                <div class="bg-surface-container-high p-space-xs rounded">
                  <span class="block font-label-xs text-[10px] text-on-surface-variant uppercase">Date</span>
                  <span class="font-headline-sm text-headline-sm italic text-on-surface font-bold">{raceDate ? raceDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : 'TBC'}</span>
                </div>
                <div class="bg-surface-container-high p-space-xs rounded">
                  <span class="block font-label-xs text-[10px] text-on-surface-variant uppercase">Rider</span>
                  <span class="font-headline-sm text-headline-sm italic text-primary-container font-bold">#32</span>
                </div>
              </div>
              <div class="pt-space-sm">
                <a class="inline-flex items-center gap-space-xs px-space-md py-space-sm bg-surface-container-high hover:bg-surface-variant text-on-surface font-headline-sm text-headline-sm uppercase italic tracking-wider transition-all" href="/calendar/">
                  <span>View Full Calendar</span><span class="material-symbols-outlined text-[18px]">calendar_today</span>
                </a>
              </div>
            </div>
            <div class="lg:col-span-6 flex flex-col items-center lg:items-end relative">
              <span class="font-label-xs text-label-xs uppercase tracking-widest text-on-surface-variant mb-space-sm">Race weekend commences in:</span>
              <div class="grid grid-cols-4 gap-space-sm text-center w-full max-w-md" data-countdown={race?.date ?? ''}>
                {[['days', 'Days'], ['hours', 'Hours'], ['mins', 'Mins'], ['secs', 'Secs']].map(([id, label], i) => (
                  <div class="bg-surface-container-highest p-space-sm rounded-lg flex flex-col justify-center">
                    <span class:list={['font-display-hero text-headline-xl-mobile sm:text-headline-xl font-black italic leading-none', i === 3 ? 'text-primary-container' : 'text-on-surface']} id={`countdown-${id}`}>--</span>
                    <span class="font-label-xs text-label-xs uppercase tracking-wider text-on-surface-variant mt-1">{label}</span>
                  </div>
                ))}
              </div>
              <div class="mt-space-md w-full max-w-md flex items-center justify-between p-space-sm bg-surface-container-lowest/80 rounded">
                <div class="flex items-center gap-space-xs text-on-surface-variant">
                  <span class="material-symbols-outlined text-primary-container">location_on</span>
                  <span class="font-label-xs text-label-xs uppercase">{race ? race.circuit : 'Venue TBC'}</span>
                </div>
                <a class="px-space-xs py-0.5 bg-primary-container/20 text-primary font-label-xs text-[10px] uppercase font-bold" href={site.instagram} target="_blank" rel="noopener">Follow Live</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. SPONSORS -->
    <section class="w-full py-space-xl bg-surface-container-lowest relative">
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin">
