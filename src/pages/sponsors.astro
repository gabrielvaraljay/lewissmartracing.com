---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SponsorCta from '../components/SponsorCta.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { sponsors } from '../data/site';
const tiers = [
  { id: 'title', name: 'Title partner' },
  { id: 'partner', name: 'Official partners' },
  { id: 'supporter', name: 'Supporters' },
] as const;
// Package names only; content and pricing to be agreed with Lewis.
const packages = [
  { name: 'Supporter', points: ['Logo on the website', 'Social media thank-you posts', 'Race weekend updates'] },
  { name: 'Partner', points: ['Logo on the bike', 'Regular social features', 'Paddock hospitality'] },
  { name: 'Title', points: ['Prime bike and leathers placement', 'Content made for your brand', 'Appearances and events'] },
];
---
<Base title="Sponsors" description="Partner with Lewis Smart #32. Sponsorship packages, deck download and enquiries.">
  <PageHeader kicker="Sponsors" title="Race" accent="with us" intro="Every race weekend is powered by partners. Here is who backs #32, and how your business can join them." />

  <section class="section">
    <div class="container">
      {tiers.map((t) => {
        const list = sponsors.filter((s) => s.tier === t.id);
        return (
          <div class="tier">
            <h2 class="h-md">{t.name}</h2>
            <div class:list={['tier__logos', `tier__logos--${t.id}`]}>
              {list.length
                ? list.map((s) => <a class="tier__logo" href={s.url} target="_blank" rel="noopener"><img src={s.logo} alt={s.name} loading="lazy" /></a>)
                : <div class="tier__logo tier__logo--empty"><span class="label">Available</span></div>}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section section--panel slant-top">
    <div class="container">
      <div class="section-head"><div><div class="kicker"><span class="label">Packages</span></div><h2 class="h-xl">Ways to partner</h2></div></div>
      <div class="pk">
        {packages.map((p, i) => (
          <article class:list={['card card--chamfer pk__card', { 'pk__card--top': i === 2 }]} data-reveal>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h-lg">{p.name}</h3>
            <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="tbc" style="margin-top:1.5rem">Packages are flexible and tailored to each partner.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="display:grid;gap:3rem">
      <SponsorCta />
      <div id="enquire">
        <div class="kicker"><span class="label">Enquiry</span></div>
        <h2 class="h-xl" style="margin-bottom:2rem">Start the conversation</h2>
        <EnquiryForm topic="sponsorship" />
      </div>
    </div>
  </section>
</Base>
<style>
  .tier { margin-bottom: 3rem; }
  .tier h2 { margin-bottom: 1.25rem; }
  .tier__logos { display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .tier__logos--title { grid-template-columns: 1fr; }
  .tier__logo { display: grid; place-items: center; aspect-ratio: 16 / 7; background: var(--surface); border: 1px solid var(--hairline); padding: 1.5rem; }
  .tier__logos--title .tier__logo { aspect-ratio: auto; min-height: 180px; border-color: var(--accent-line); }
  .tier__logo img { max-height: 70px; width: auto; }
  .tier__logo--empty { border-style: dashed; }
  .pk { display: grid; gap: var(--gutter); }
  .pk__card { display: grid; gap: 1rem; align-content: start; padding: 2rem; }
  .pk__card ul { margin: 0; padding: 0; list-style: none; display: grid; gap: .6rem; color: var(--text-2); }
  .pk__card li { display: flex; gap: .6rem; }
  .pk__card li::before { content: ''; flex: none; width: 8px; height: 8px; margin-top: .55rem; background: var(--accent); transform: rotate(45deg); }
  .pk__card--top { border-color: var(--accent-line); }
  @media (min-width: 900px) { .pk { grid-template-columns: repeat(3, 1fr); } }
</style>
