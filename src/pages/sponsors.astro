---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SponsorCta from '../components/SponsorCta.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { sponsors } from '../data/site';
const tiers = [
  { id: 'title', name: 'Title partner' },
  { id: 'partner', name: 'Official partners' },
  { id: 'supporter', name: 'Supporters' },
] as const;
// From Lewis's 2027 sponsorship call on Facebook.
const offers = [
  { title: 'Bike, leathers and helmet', body: 'Your company logo on the race bike, leathers and helmet, in front of BSB crowds and TV cameras.' },
  { title: 'Social media exposure', body: 'Regular sharing, tagging and promotion of your business across our platforms.' },
  { title: 'Workplace visits', body: 'Visits to your workplace for photos, videos and promotional content.' },
  { title: 'BSB race weekend tickets', body: 'Complimentary tickets to selected BSB race weekends: meet the team and experience the paddock.' },
  { title: 'Bespoke promotion', body: 'Promotional opportunities tailored to help your business gain exposure.' },
  { title: 'Newsletter features', body: 'Your logo, linked to your website, in every Lewis Smart #32 newsletter and Club32 race update sent to fans and supporters.' },
];
---
<Base title="Sponsors" description="2027 sponsorship opportunities with Lewis Smart #32 in the Pirelli British Sportbike Championship." image="/images/og/sponsors.jpg">
  <PageHeader kicker="2027 Sponsorship" title="Race" accent="with us" intro="After a season of consistent top 10 finishes in the Pirelli British Sportbike Championship, including 4th at Oulton Park, we're looking ahead to 2027 with one clear goal: turning that pace into podium finishes." />

  <section class="section">
    <div class="container about">
      <p class="lead">As a small, family-run racing team, we're looking for new and existing sponsors to join us. With 10 rounds of the championship ahead, there are great opportunities to get your business, brand or company noticed while supporting a team with big ambitions.</p>
      <p>We pride ourselves on being approachable, flexible and easy to work with, and we want every partnership to be worthwhile and rewarding for everyone involved. Whether you're a local business, an established company or simply someone who wants to support a small team chasing big dreams, we'd love to have you on board.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {tiers.map((t) => {
        const list = sponsors.filter((s) => s.tier === t.id);
        return (
          <div class="tier">
            <h2 class="h-md">{t.name}</h2>
            <div class:list={['tier__logos', `tier__logos--${t.id}`]}>
              {list.length
                ? list.map((s) => s.url
                    ? <a class="tier__logo tier__logo--brand" style={`--logo-bg:${s.bg}`} href={s.url} target="_blank" rel="noopener" title={s.name}><img src={s.logo} alt={s.name} loading="lazy" /></a>
                    : <div class="tier__logo tier__logo--brand" style={`--logo-bg:${s.bg}`} title={s.name}><img src={s.logo} alt={s.name} loading="lazy" /></div>)
                : <div class="tier__logo tier__logo--empty"><span class="label">{t.id === 'title' ? 'Coming soon' : 'Available'}</span></div>}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section section--panel slant-top">
    <div class="container">
      <div class="section-head"><div><div class="kicker"><span class="label">What we offer</span></div><h2 class="h-xl">What sponsors get</h2></div></div>
      <div class="pk">
        {offers.map((o, i) => (
          <article class:list={['card card--chamfer pk__card', { 'pk__card--top': i === 0 }]} data-reveal>
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h-lg">{o.title}</h3>
            <p>{o.body}</p>
          </article>
        ))}
      </div>
      <p class="tbc" style="margin-top:1.5rem">Every partnership is tailored. Get in touch below, drop us a DM on Instagram or Facebook, or email <a href="mailto:smart.racing32@gmail.com">smart.racing32@gmail.com</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="display:grid;gap:3rem">
      <SponsorCta />
      <div id="enquire">
        <div class="kicker"><span class="label">Enquiry</span></div>
        <h2 class="h-xl" style="margin-bottom:2rem">Start the conversation</h2>
        <EnquiryForm topic="sponsorship" />
      </div>
    </div>
  </section>
</Base>
<style>
  .tier { margin-bottom: 3rem; }
  .tier h2 { margin-bottom: 1.25rem; }
  .tier__logos { display: grid; gap: var(--gutter); grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .tier__logos--title { grid-template-columns: 1fr; }
  .tier__logo { display: grid; place-items: center; aspect-ratio: 16 / 7; background: var(--surface); border: 1px solid var(--hairline); padding: 1.5rem; }
  .tier__logos--title .tier__logo { aspect-ratio: auto; min-height: 180px; border-color: var(--accent-line); }
  .tier__logo img { max-height: 70px; width: auto; }
  .tier__logo--empty { border-style: dashed; }
  .tier__logo--brand { background: var(--logo-bg); border-color: transparent; aspect-ratio: 16 / 9; padding: 0; min-width: 0; overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; }
  a.tier__logo--brand:hover { transform: translateY(-3px); box-shadow: 0 0 0 2px var(--accent, #d6f20a); }
  .tier__logo--brand img { width: 72%; height: 62%; min-width: 0; max-height: none; object-fit: contain; }
  .tier__logos--partner { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  @media (min-width: 640px) { .tier__logos--partner { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gutter); } }
  @media (min-width: 1100px) { .tier__logos--partner { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pk { display: grid; gap: var(--gutter); }
  .pk__card { display: grid; gap: 1rem; align-content: start; padding: 2rem; }
  .pk__card p { margin: 0; color: var(--text-2); }
  .about { display: grid; gap: 1.25rem; max-width: 60rem; }
  .about p { margin: 0; color: var(--text-2); }
  .about .lead { font-size: 1.25rem; color: var(--text); }
  .pk__card--top { border-color: var(--accent-line); }
  @media (min-width: 700px) { .pk { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .pk { grid-template-columns: repeat(3, 1fr); } }
</style>
