---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
// Photos: put files in /public/images/gallery and list them here.
const photos: { src: string; alt: string; w: number; h: number }[] = [];
// Vertical 9:16 reels from Instagram/Facebook: /public/reels/*.mp4 (+ poster).
const reels: { src: string; poster: string; title: string }[] = [];
const ph = [ [16, 10], [4, 5], [16, 9], [1, 1], [3, 4], [16, 10], [4, 5], [16, 9] ];
---
<Base title="Gallery" description="Photos and reels of Lewis Smart #32 on and off track.">
  <PageHeader kicker="Gallery" title="On" accent="track" intro="Race weekends, testing and behind the scenes." />
  <section class="section">
    <div class="container">
      <div class="masonry" data-gallery>
        {photos.length
          ? photos.map((p, i) => (
              <button class="m__item" type="button" data-full={p.src} data-alt={p.alt} aria-label={`Open photo: ${p.alt}`}>
                <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              </button>
            ))
          : ph.map(([w, h], i) => <div class="m__item placeholder-img" style={`aspect-ratio:${w}/${h}`}><span>Photo {i + 1}</span></div>)}
      </div>
    </div>
  </section>

  <section class="section section--panel slant-top">
    <div class="container">
      <div class="section-head"><div><div class="kicker"><span class="label">Reels</span></div><h2 class="h-xl">In motion</h2></div>
        <a class="link-arrow" href={site.instagram} target="_blank" rel="noopener">More on Instagram</a></div>
      <div class="reels">
        {reels.length
          ? reels.map((r) => <video class="reel" src={r.src} poster={r.poster} controls playsinline preload="none" aria-label={r.title}></video>)
          : Array.from({ length: 4 }, (_, i) => <div class="reel placeholder-img"><span>Reel {i + 1}</span></div>)}
      </div>
    </div>
  </section>

  <dialog class="lb" data-lb>
    <button class="lb__close btn btn--ghost" type="button" data-lb-close>Close</button>
    <img alt="" data-lb-img />
  </dialog>
</Base>

<script>
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach((b) =>
    b.addEventListener('click', () => { img.src = b.dataset.full!; img.alt = b.dataset.alt || ''; lb.showModal(); }));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
</script>

<style>
  .masonry { columns: 2 160px; column-gap: .5rem; }
  .m__item { display: block; width: 100%; margin: 0 0 .5rem; padding: 0; border: 0; background: none; cursor: zoom-in; break-inside: avoid; overflow: hidden; }
  .m__item img { width: 100%; height: auto; transition: transform .5s; }
  .m__item:hover img { transform: scale(1.03); }
  .reels { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr); gap: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; }
  .reel { aspect-ratio: 9 / 16; width: 100%; object-fit: cover; scroll-snap-align: start; background: #000; }
  .lb { max-width: 96vw; max-height: 94vh; padding: 0; border: 1px solid var(--accent-line); background: var(--surface-inset); }
  .lb::backdrop { background: rgb(7 7 9 / .95); backdrop-filter: blur(16px); }
  .lb img { max-width: 96vw; max-height: 94vh; object-fit: contain; }
  .lb__close { position: absolute; top: .75rem; right: .75rem; background: rgb(0 0 0 / .6); }
  @media (min-width: 768px) { .masonry { columns: 3; column-gap: var(--gutter); } .m__item { margin-bottom: var(--gutter); } }
  @media (min-width: 1200px) { .masonry { columns: 4; } }
</style>
