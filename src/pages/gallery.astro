---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
// Vertical 9:16 reels from Instagram, newest first: /public/reels/*.mp4 (720p H.264) + .webp poster.
// Lewis's photos are on the My Story timeline (src/data/story-photos.json), not here.
import reels from '../data/reels.json';
---
<Base title="Gallery" description="Reels of Lewis Smart #32 on and off track: race weekends, onboard laps and the team, from the 2026 season." image="/images/og/gallery.jpg">
  <PageHeader kicker="Gallery" title="In" accent="motion" intro="Race weekends, onboard laps and behind the scenes." />
  <section class="section">
    <div class="container">
      <div class="section-head"><div><div class="kicker"><span class="label">Reels</span></div><h2 class="h-xl">Latest reels</h2></div>
        <a class="link-arrow" href={site.instagram} target="_blank" rel="noopener">More on Instagram</a></div>
      <div class="reels">
        {reels.map((r) => (
          <figure class="reel__item">
            <video class="reel" src={r.src} poster={r.poster} controls playsinline preload="none" aria-label={r.title}></video>
            <figcaption class="reel__cap">{r.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .reels { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr); gap: var(--gutter); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; }
  .reel { aspect-ratio: 9 / 16; width: 100%; object-fit: cover; background: #000; }
  .reel__item { margin: 0; scroll-snap-align: start; }
  .reel__cap { margin-top: .6rem; font-family: var(--font-display); font-weight: 700; font-style: italic; text-transform: uppercase; letter-spacing: .04em; color: var(--text-2); }
</style>
