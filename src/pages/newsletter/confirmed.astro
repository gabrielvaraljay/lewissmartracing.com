---
// Step 2 of the double opt-in: BlueFox redirects here after the confirmation link is clicked.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
---
<Base title="Subscription confirmed" description="You're on the list for news from Lewis Smart #32.">
  <meta slot="head" name="robots" content="noindex, follow" />
  <PageHeader kicker="Subscription confirmed" title="Welcome" accent="aboard" intro="You're on the list. Thanks for backing #32! You'll be among the first to hear the big announcement, along with race weekend news and updates from the paddock." />
  <section class="section">
    <div class="container"><div class="ok">
      <p class="ok__tip">One more thing: if you haven't already, add <strong class="accent">32@lewissmartracing.com</strong> to your contacts so our emails always reach your inbox.</p>
      <div class="ok__actions">
        <a class="btn btn--primary" href="/my-story/">Read the story <span class="arrow"><Icon name="arrow" size={18} /></span></a>
        <a class="btn btn--ghost" href="/calendar/">Race calendar</a>
      </div>
      <div class="ok__social">
        <span class="label">Follow #32 in the meantime</span>
        <div class="ok__actions">
          <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> @lewis.smart32</a>
          <a class="btn btn--ghost" href={site.facebook} target="_blank" rel="noopener"><Icon name="facebook" size={18} /> Follow on Facebook</a>
        </div>
      </div>
    </div></div>
  </section>
</Base>
<style>
  .ok { display: grid; gap: 2.5rem; max-width: 46rem; }
  .ok__tip { margin: 0; padding: 1.25rem; background: rgb(255 255 255 / 0.03); border-left: 4px solid var(--accent, #d6f20a); line-height: 1.6; }
  .ok__actions { display: flex; flex-wrap: wrap; gap: 1rem; }
  .ok__social { display: grid; gap: 1rem; }
</style>
