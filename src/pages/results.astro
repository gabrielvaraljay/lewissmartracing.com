---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { timeline } from '../data/site';
// Race-by-race results from the official TSL Timing classifications (tsl-timing.com).
// Generated by scripts/results/ (crawl.py -> parse.py -> build.py); see README "Results".
import results from '../data/results.json';

type Row = (typeof results)[number];
const isPos = (p: string) => /^\d+$/.test(p);
// In mixed-class No Limits grids and in endurance races the class position is the result that counts.
const effective = (r: Row) => (r.series !== 'BSB' && r.classPos ? r.classPos : r.pos);
const podium = (p: string) => isPos(p) && Number(p) <= 3;

const years = [...new Set([...results.map((r) => String(r.year)), ...timeline.map((t) => t.year)])].sort((a, b) => Number(b) - Number(a));
const seasons = years.map((year) => {
  const rows = results.filter((r) => String(r.year) === year);
  const champs = [...new Set(rows.map((r) => r.championship))];
  const groups = champs
    .map((c) => ({ name: c, rows: rows.filter((r) => r.championship === c) }))
    // BSB first, then the busiest championship
    .sort((a, b) => Number(b.rows[0].series === 'BSB') - Number(a.rows[0].series === 'BSB') || b.rows.length - a.rows.length);
  const finishes = rows.map(effective).filter(isPos).map(Number);
  const bsb = rows.filter((r) => r.series === 'BSB').map((r) => r.pos).filter(isPos).map(Number);
  return {
    year,
    story: timeline.find((t) => t.year === year),
    groups,
    stats: rows.length
      ? [
          { label: 'Races', value: rows.length },
          { label: 'Wins', value: finishes.filter((p) => p === 1).length },
          { label: 'Podiums', value: finishes.filter((p) => p <= 3).length },
          { label: 'Best BSB finish', value: bsb.length ? `P${Math.min(...bsb)}` : '–' },
        ]
      : [],
  };
});
const posLabel = (p: string) => (isPos(p) ? `P${p}` : p);
---
<Base title="Results" description="Race-by-race results for Lewis Smart #32 from the official timing sheets, season by season." image="/images/og/results.jpg">
  <PageHeader kicker="Results" title="Every" accent="lap counts" intro="Race-by-race results from the official timing sheets: British Superbikes support classes, No Limits Racing sprints and endurance, season by season." />
  <section class="section">
    <div class="container">
      <div class="tabs" role="tablist" aria-label="Season">
        {seasons.map((s, i) => (
          <button role="tab" class="tab" id={`tab-${s.year}`} aria-controls={`panel-${s.year}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.year}</button>
        ))}
      </div>
      {seasons.map((s, i) => (
        <div role="tabpanel" id={`panel-${s.year}`} aria-labelledby={`tab-${s.year}`} hidden={i !== 0} class="panel">
          <div class="panel__head">
            <h2 class="h-lg">{s.year} <span class="accent">Season</span></h2>
            {s.story && <span class="chip">{s.story.series}: {s.story.result}</span>}
          </div>

          {s.stats.length > 0 && (
            <div class="stats">
              {s.stats.map((st) => (
                <div class="stat"><span class="num stat__v">{st.value}</span><span class="label">{st.label}</span></div>
              ))}
            </div>
          )}

          {s.groups.length
            ? s.groups.map((g) => {
                const hasClass = g.rows.some((r) => r.series !== 'BSB' && r.classPos);
                const endurance = g.rows[0].endurance;
                return (
                  <div class="champ">
                    <div class="champ__head">
                      <h3 class="h-md">{g.name}</h3>
                      <span class:list={['chip', { 'chip--accent': g.rows[0].series === 'BSB' }]}>{g.rows[0].series === 'BSB' ? 'British Superbikes' : 'No Limits Racing'}</span>
                    </div>
                    <div class="tbl-wrap">
                      <table class="tbl">
                        <thead>
                          <tr>
                            <th>Round</th><th>Circuit</th><th class="opt">Date</th><th>{endurance ? 'Team-mates' : 'Race'}</th>
                            <th class="r">{hasClass ? 'Overall' : 'Pos'}</th>
                            {hasClass && <th class="r">Class</th>}
                            <th class="r opt">Best lap</th><th class="r opt"><span class="sr-only">Source</span></th>
                          </tr>
                        </thead>
                        <tbody>
                          {g.rows.map((r) => {
                            const key = hasClass ? r.classPos ?? '' : r.pos;
                            return (
                              <tr class:list={{ win: key === '1', podium: podium(key) }}>
                                <td class="nowrap">{r.round.replace('Round ', 'R')}</td>
                                <td>{r.venue}</td>
                                <td class="muted nowrap opt">{r.date}</td>
                                <td class:list={{ nowrap: !endurance }}>{endurance ? (r.teamMates?.join(', ') || '–') : r.race}</td>
                                <td class:list={['r num pos', { 'pos--top': !hasClass && podium(r.pos) }]}>{posLabel(r.pos)}</td>
                                {hasClass && <td class:list={['r num pos', { 'pos--top': podium(r.classPos ?? '') }]}>{r.classPos ? `P${r.classPos}` : '–'}</td>}
                                <td class="r muted opt">{r.bestLap ?? '–'}</td>
                                <td class="r opt"><a class="src" href={r.source} target="_blank" rel="noopener" title="Official TSL Timing result (PDF)">PDF</a></td>
                              </tr>
                            );
                          })}
                        </tbody>
                      </table>
                    </div>
                  </div>
                );
              })
            : <p class="tbc">{s.story ? `${s.story.series}: ${s.story.result}. ` : ''}Race-by-race timing sheets for {s.year} are not available online.</p>}
        </div>
      ))}
      <p class="muted note">Source: official classifications from <a href="https://www.tsl-timing.com/Results" target="_blank" rel="noopener">TSL Timing</a>. In mixed-class No Limits races and endurance races, “Class” is Lewis's position in his own class.</p>
    </div>
  </section>
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
    t.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') select(tabs[(i + 1) % tabs.length]);
      if (e.key === 'ArrowLeft') select(tabs[(i - 1 + tabs.length) % tabs.length]);
    });
  });
</script>

<style>
  .tabs { display: flex; gap: .25rem; overflow-x: auto; border-bottom: 1px solid var(--hairline); margin-bottom: 2.5rem; scrollbar-width: none; }
  .tab { flex: none; background: none; border: 0; cursor: pointer; padding: .9rem 1.25rem; font-family: var(--font-display); font-weight: 800; font-style: italic; font-size: 1.5rem; color: var(--text-3); position: relative; }
  .tab[aria-selected='true'] { color: var(--text); }
  .tab[aria-selected='true']::after { content: ''; position: absolute; left: .75rem; right: .75rem; bottom: -1px; height: 3px; background: var(--accent); transform: skewX(-20deg); }
  .panel__head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); margin-bottom: 3rem; }
  @media (min-width: 768px) { .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stat { display: grid; gap: .35rem; padding: 1.25rem 1.5rem; background: var(--surface); }
  .stat__v { font-size: 2.5rem; color: var(--accent); }
  .champ { margin-bottom: 3rem; }
  .champ__head { display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .tbl-wrap { overflow-x: auto; border: 1px solid var(--hairline); }
  .tbl { width: 100%; border-collapse: collapse; min-width: 640px; }
  .tbl th { text-align: left; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-2); padding: .9rem 1rem; background: var(--surface-inset); white-space: nowrap; }
  .tbl td { padding: .8rem 1rem; border-top: 1px solid rgb(255 255 255 / .06); font-variant-numeric: tabular-nums; }
  .tbl tbody tr:nth-child(odd) { background: var(--surface); }
  .tbl tbody tr:nth-child(even) { background: var(--row-alt); }
  .tbl tbody tr { box-shadow: inset 0 0 0 transparent; transition: box-shadow .2s; }
  .tbl tbody tr:hover, .tbl tbody tr.podium { box-shadow: inset 3px 0 0 var(--accent); }
  .tbl .r { text-align: right; }
  .tbl .nowrap { white-space: nowrap; }
  .pos { font-size: 1.35rem; white-space: nowrap; }
  .pos--top { color: var(--accent); }
  .win .pos--top::after { content: ' 🏆'; font-size: 1rem; font-style: normal; }
  .src { font-size: 11px; letter-spacing: .12em; font-weight: 700; color: var(--text-3); text-decoration: none; border: 1px solid var(--hairline); padding: .2rem .45rem; }
  .src:hover { color: var(--accent); border-color: var(--accent-line); }
  .note { margin-top: 1rem; font-size: .875rem; }
  @media (max-width: 640px) {
    .tbl { min-width: 0; }
    .tbl .opt { display: none; }
    .tbl th, .tbl td { padding: .7rem .6rem; }
    .pos { font-size: 1.15rem; }
  }
  .note a { color: var(--text-2); }
</style>
