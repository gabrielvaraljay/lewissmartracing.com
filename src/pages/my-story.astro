---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SponsorCta from '../components/SponsorCta.astro';
import { timeline } from '../data/site';
---
<Base title="My Story" description="From a Honda CB500 in the Freshman Championship to racing with Triumph: the Lewis Smart #32 story, season by season.">
  <PageHeader kicker="My Story" title="From Freshman" accent="to Triumph"
    intro="Six seasons, one direction: forward. This is how a race technician from Silverstone Motorsport College became a front runner, one season at a time." />

  <section class="section">
    <div class="container">
      <ol class="tl" data-tl>
        <span class="tl__rail" aria-hidden="true"><span class="tl__fill"></span></span>
        {timeline.map((t, i) => (
          <li class:list={['tl__item', { 'tl__item--now': i === timeline.length - 1 }]} data-reveal>
            <span class="tl__node" aria-hidden="true"></span>
            <div class="tl__year num" aria-hidden="true">{t.year}</div>
            <article class="tl__card card card--chamfer">
              <div class="btn-row" style="gap:.5rem">
                <span class="chip chip--accent">{t.year}</span>
                <span class="chip">{t.series}</span>
                {t.bike && <span class="chip">{t.bike}</span>}
              </div>
              <h2 class="h-lg">{t.title}</h2>
              <p class="tl__result"><span class="slash"></span> {t.result}</p>
              <p class="muted">{t.body}</p>
              <div class="placeholder-img tl__img"><span>{t.year} photo</span></div>
            </article>
          </li>
        ))}
        <li class="tl__item tl__item--next" data-reveal>
          <span class="tl__node" aria-hidden="true"></span>
          <div class="tl__year num" aria-hidden="true">Next</div>
          <article class="tl__card tl__card--next">
            <span class="label accent">The goal</span>
            <h2 class="h-xl">British Superbikes</h2>
            <p class="lead">The long-term target is the British Superbike Championship. Getting there takes results, and the right partners. This is where you come in.</p>
          </article>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--panel slant-top">
    <div class="container quotes">
      <figure class="quote" data-reveal>
        <span class="label">Advice to young racers</span>
        <blockquote class="h-lg">Stick with it. Hard work and perseverance <span class="accent">turn things around.</span></blockquote>
      </figure>
      <div class="facts" data-reveal>
        <div class="fact"><span class="label">Dream race</span><span class="h-md">Yamaha R1 at Mugello</span></div>
        <div class="fact"><span class="label">Training</span><span class="h-md">Gym five days a week</span></div>
        <div class="fact"><span class="label">Day job</span><span class="h-md">Full-time electrician</span></div>
        <div class="fact"><span class="label">Fuel</span><span class="h-md">Meals prepped by Mum</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container"><SponsorCta heading="Be part of the next chapter" /></div>
  </section>
</Base>

<script>
  const tl = document.querySelector<HTMLElement>('[data-tl]');
  if (tl) {
    const update = () => {
      const r = tl.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
      tl.style.setProperty('--tl', p.toFixed(4));
    };
    update();
    addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    addEventListener('resize', update);
  }
</script>

<style>
  .tl { --tl: 0; position: relative; list-style: none; margin: 0; padding: 0 0 0 2.25rem; display: grid; gap: clamp(2.5rem, 7vw, 5rem); }
  .tl__rail { position: absolute; left: .5rem; top: .5rem; bottom: 0; width: 2px; background: var(--hairline-2); }
  .tl__fill { position: absolute; inset: 0; background: linear-gradient(var(--accent), var(--accent) 80%, var(--purple)); transform-origin: top; transform: scaleY(var(--tl)); box-shadow: 0 0 12px var(--accent-glow); }

  .tl__item { position: relative; display: grid; gap: 1rem; }
  .tl__node { position: absolute; left: calc(-2.25rem + .5rem - 7px); top: .9rem; width: 16px; height: 16px; background: var(--bg); border: 2px solid var(--accent); transform: rotate(45deg); }
  .tl__item--now .tl__node, .tl__item--next .tl__node { background: var(--accent); box-shadow: 0 0 16px var(--accent); }
  .tl__year { font-size: clamp(3.5rem, 12vw, 7rem); color: transparent; -webkit-text-stroke: 1.5px var(--text-3); }
  .tl__item--now .tl__year { -webkit-text-stroke-color: var(--accent); }
  .tl__item--next .tl__year { color: var(--accent); -webkit-text-stroke: 0; }

  .tl__card { display: grid; gap: 1rem; padding: clamp(1.5rem, 4vw, 2.25rem); }
  .tl__card p { margin: 0; }
  .tl__item--now .tl__card { border-color: var(--accent-line); }
  .tl__result { font-family: var(--font-display); font-weight: 800; font-style: italic; text-transform: uppercase; font-size: 1.35rem; letter-spacing: .03em; display: flex; align-items: center; gap: .6rem; color: var(--accent); }
  .tl__img { aspect-ratio: 16 / 9; margin-top: .5rem; }
  .tl__card--next { display: grid; gap: 1rem; padding: clamp(1.5rem, 4vw, 2.25rem); background: linear-gradient(135deg, var(--purple-deep), var(--surface) 70%); border-left: 4px solid var(--purple); }

  .quotes { display: grid; gap: 3rem; }
  .quote { margin: 0; display: grid; gap: 1rem; border-left: 4px solid var(--accent); padding-left: clamp(1.25rem, 3vw, 2rem); }
  .quote blockquote { margin: 0; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--hairline); border: 1px solid var(--hairline); }
  .fact { display: grid; gap: .5rem; align-content: start; background: var(--surface); padding: 1.5rem 1.25rem; }

  @media (min-width: 900px) {
    .tl { padding-left: 0; }
    .tl__rail { left: 50%; transform: translateX(-1px); }
    .tl__item { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
    .tl__node { left: calc(50% - 8px); top: 2.25rem; }
    .tl__year { text-align: right; padding-top: .5rem; }
    .tl__item:nth-child(odd) .tl__year { order: 2; text-align: left; }
    .tl__item:nth-child(odd) .tl__card { order: 1; }
    .quotes { grid-template-columns: 1.2fr 1fr; align-items: center; }
  }
</style>
