---
// My Story / career timeline. Layout ported 1:1 from the Google Stitch design; copy limited to confirmed facts.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

type Entry = {
  year: string; tag: string; title: string; machine: string; body: string; pills: string[];
  image?: { src: string; alt: string }; caption: string; node: 'live' | 'dim' | 'trophy' | 'solid' | 'active';
  champion?: boolean; active?: boolean;
};
// Newest first: the current season sits at the top, then the story goes back in time.
const entries: Entry[] = ([
  {
    year: '2020', tag: 'Debutant // Freshman', title: 'Grassroots Fire & Debut Season', machine: 'Machine: Honda CB500',
    body: 'After training as a race technician at Silverstone Motorsport College, and inspired by a racing classmate, Lewis entered the Freshman Championship. A COVID-delayed calendar could not slow him down: several race wins and 3rd overall in his first ever season of road racing.',
    pills: ['🏁 P3 Overall Championship', '⏱ Multiple Race Wins'], caption: '2020 // Freshman Championship', node: 'live',
  },
  {
    year: '2021', tag: 'Elevation // BSB Paddock', title: 'Stepping Up to Sportsman & BSB Wildcard', machine: 'Sportsman Championship & BSB Junior Supersport',
    body: 'A step up to the Sportsman Championship brought regular podiums. A late-season wildcard in British Superbikes Junior Supersport then gave Lewis his first taste of the national paddock, racing against the best young riders in the country.',
    pills: ['🏆 Sportsman Podiums', '⚡ British Superbikes Wildcard Debut'], caption: '2021 // BSB Junior Supersport', node: 'dim',
  },
  {
    year: '2022', tag: 'Championship Title', title: 'CB500 Sportsman Champion', machine: 'Machine: Honda CB500 // #23',
    body: 'The breakthrough title. Racing as #23, Lewis won the CB500 Sportsman Championship, while also racing in Junior Supersport, finishing in the 20s and learning fast against front-running national machinery.',
    pills: ['🥇 2022 CB500 Sportsman Champion', '📊 Junior Supersport Experience'], caption: '2022 // Championship Crowned', node: 'trophy', champion: true,
  },
  {
    year: '2023', tag: 'Breakthrough // BSB Support', title: 'The Breakthrough Junior Supersport Podium', machine: 'British Superbikes Junior Supersport',
    body: 'His first Junior Supersport podium arrived mid-season, and Lewis ended the year the best way possible: with a race win.',
    pills: ['⚡ First Junior Supersport Podium', '🏁 Season-Ending Race Win', '🥇 Club 600 Endurance Champion'], caption: '2023 // Junior Supersport', node: 'dim',
  },
  {
    year: '2024', tag: 'Scouted // P3 Overall', title: 'Kawasaki ZX-4RR Campaign & Factory Eyes', machine: 'Machine: Kawasaki ZX-4RR',
    body: 'On the Kawasaki ZX-4RR Lewis delivered consistent wins and podiums to finish 3rd in the BSB Kawasaki Superteens championship, and won the NLR National 600 Endurance series. That form caught the attention of Triumph.',
    pills: ['🏁 P3 BSB Kawasaki Superteens', '🥇 National 600 Endurance Champion', '📋 Triumph Attention'], caption: '2024 // Kawasaki ZX-4RR', node: 'solid',
  },
  {
    year: '2025', tag: 'Triumph', title: 'The Triumph Era', machine: 'Machine: Triumph Daytona 660',
    body: 'A factory ride with Macadam Triumph Factory Racing in the Pirelli National Sportbike Championship, in the fluorescent #32 livery. The debut season closed with a season-best 5th place at the Brands Hatch finale.',
    pills: ['🏭 Macadam Triumph Factory Racing', '🏁 Season-Best P5, Brands Hatch'], image: { src: '/images/hero-static.webp', alt: 'Lewis Smart cornering on the 2025 number 32 bike' },
    caption: 'Macadam Triumph // #32', node: 'solid',
  },
  {
    year: '2026', tag: 'British Sportbike // Top 10', title: 'Top 10 Regular', machine: 'Pirelli British Sportbike Championship',
    body: 'A season of consistent top 10 finishes in the Pirelli British Sportbike Championship at Bennetts British Superbikes, with a best of 4th at Oulton Park. The work for 2027 has already started: turning that pace into podium finishes.',
    pills: ['🏁 Best P4, Oulton Park', '🎯 2027 Target: Podiums'], caption: '2026 // #32', node: 'active', active: true,
  },
] as Entry[]).reverse();
const roadmap = [
  { label: 'Freshman Championship', state: 'done' },
  { label: 'Sportsman Champion', state: 'done' },
  { label: 'Junior Supersport Wins', state: 'done' },
  { label: 'Endurance Champion', state: 'done' },
  { label: 'Racing with Triumph', state: 'done' },
  { label: 'British Sportbike Podiums', state: 'now' },
  { label: 'British Supersport', state: 'goal' },
  { label: 'British Superbikes', state: 'goal' },
];
---
<Base title="My Story" description="From a Honda CB500 in the Freshman Championship to racing with Triumph: the Lewis Smart #32 story, season by season.">
  <div class="flex flex-col w-full relative">
    <!-- HERO BANNER -->
    <section class="relative w-full overflow-hidden bg-surface-container-lowest py-space-xl lg:py-margin-lg">
      <div class="pointer-events-none select-none absolute -right-12 -top-10 lg:right-6 lg:-top-16 opacity-[0.04] font-display-hero text-[180px] lg:text-[340px] text-on-surface font-black italic tracking-tighter leading-none z-0" aria-hidden="true">#32</div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_0%,rgba(214,242,10,0.12),transparent_70%)] pointer-events-none z-0"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-margin-sm lg:px-margin">
        <div class="inline-flex items-center gap-space-xs px-space-md py-1 bg-surface-container-high text-on-surface rounded-full shadow-md mb-space-md">
          <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
          <span class="font-label-xs text-label-xs uppercase tracking-widest text-on-surface-variant">Paddock Chronology // 2020 to the future</span>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center">
          <div class="lg:col-span-8 space-y-space-md">
            <div class="inline-block px-space-sm py-0.5 bg-primary-container text-on-primary-container font-label-xs text-label-xs uppercase tracking-widest font-black italic">From Paddock Spanners to Factory Leathers</div>
            <h1 class="font-display-hero text-headline-xl-mobile sm:text-headline-xl lg:text-display-hero uppercase tracking-tight text-on-surface font-black italic leading-none">
              MY STORY: <span class="text-primary-container">THE RACING JOURNEY</span>
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl leading-relaxed">
              Based in Sandy, Bedfordshire, and trained as a race technician at Silverstone Motorsport College. Six seasons of British road racing, from a Honda CB500 in the Freshman Championship to racing with Triumph. Driven by hard work, perseverance and a clear goal: British Superbikes.
            </p>
            <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
              <div class="px-space-md py-space-xs bg-surface-container text-on-surface rounded flex items-center gap-2">
                <span class="material-symbols-outlined text-primary-container text-[18px]">engineering</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Race Technician, Silverstone</span>
              </div>
              <div class="px-space-md py-space-xs bg-surface-container text-on-surface rounded flex items-center gap-2">
                <span class="material-symbols-outlined text-primary-container text-[18px]">emoji_events</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">3x Champion, 2022 to 2024</span>
              </div>
              <div class="px-space-md py-space-xs bg-surface-container text-on-surface rounded flex items-center gap-2">
                <span class="material-symbols-outlined text-primary-container text-[18px]">sports_motorsports</span>
                <span class="font-label-md text-label-md uppercase tracking-wider">Racing with Triumph</span>
              </div>
            </div>
          </div>
          <div class="lg:col-span-4 flex justify-center lg:justify-end">
            <div class="w-full max-w-sm bg-surface-container rounded-xl p-space-md shadow-xl relative overflow-hidden group">
              <div class="absolute -right-4 -bottom-4 font-telemetry-num text-headline-xl text-surface-container-high opacity-40 italic font-black" aria-hidden="true">#32</div>
              <div class="relative aspect-[4/5] w-full rounded-lg overflow-hidden mb-space-sm bg-surface-dim">
                <img class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" src="/images/lewis-portrait.webp" alt="Portrait of Lewis Smart behind the screen of his number 32 bike" width="540" height="720" decoding="async" />
                <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent"></div>
                <div class="absolute bottom-2 left-2 right-2 flex justify-between items-end p-space-xs">
                  <div>
                    <span class="font-label-xs text-label-xs text-on-surface-variant uppercase tracking-widest block">British Road Racer</span>
                    <span class="font-headline-sm text-headline-sm text-on-surface uppercase italic font-bold">Lewis Smart</span>
                  </div>
                  <span class="px-2 py-1 bg-primary-container text-on-primary-container font-telemetry-num text-body-md font-black italic">#32</span>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-2 text-center pt-space-xs relative">
                <div class="bg-surface-container-low p-2 rounded">
                  <span class="font-telemetry-num text-headline-sm text-primary font-black block leading-none">P3</span>
                  <span class="font-label-xs text-label-xs text-on-surface-variant uppercase">2024 Superteens</span>
                </div>
                <div class="bg-surface-container-low p-2 rounded">
                  <span class="font-telemetry-num text-headline-sm text-on-surface font-black block leading-none">2022</span>
                  <span class="font-label-xs text-label-xs text-on-surface-variant uppercase">Sportsman Title</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CAREER METRICS BAR -->
    <section class="w-full bg-surface-container-low py-space-md">
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-gutter text-left">
          {[
            { n: '07', hot: true, a: 'Seasons Competing', b: '2020 to 2026' },
            { n: '03', hot: false, a: 'Championship Titles', b: 'Sportsman & 2x Endurance' },
            { n: 'P3', hot: true, a: '2024 Superteens', b: 'Kawasaki ZX-4RR' },
            { n: 'P4', hot: false, a: '2026 Best Finish', b: 'Oulton Park' },
          ].map((m) => (
            <div class="flex items-center gap-space-sm">
              <span class:list={['font-telemetry-num text-headline-lg italic font-black', m.hot ? 'text-primary-container' : 'text-on-surface']}>{m.n}</span>
              <div>
                <div class="font-headline-sm text-body-lg uppercase font-bold text-on-surface leading-tight">{m.a}</div>
                <div class="font-label-xs text-label-xs text-on-surface-variant uppercase tracking-wider">{m.b}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- VERTICAL TIMELINE -->
    <section class="w-full py-space-xl lg:py-margin-lg bg-surface-container-lowest relative overflow-hidden">
      <div class="absolute left-1/2 top-1/4 -translate-x-1/2 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute left-1/2 bottom-1/4 -translate-x-1/2 w-96 h-96 bg-secondary-container/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-space-xl">
          <span class="font-label-md text-label-md uppercase tracking-widest text-primary-container font-bold">Season by Season</span>
          <h2 class="font-display-hero text-headline-lg-mobile sm:text-headline-lg lg:text-headline-xl uppercase italic font-black text-on-surface mt-2">THE APEX TIMELINE</h2>
          <p class="font-body-md text-body-md text-on-surface-variant mt-2">From a Honda CB500 in the Freshman Championship to racing with Triumph.</p>
        </div>
        <div class="relative w-full">
          <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-1 bg-surface-container-high md:-translate-x-1/2">
            <div class="w-full h-full bg-gradient-to-t from-primary-container via-secondary-container to-primary"></div>
          </div>
          <div class="space-y-space-xl md:space-y-margin-lg">
            <!-- THE FUTURE (top: newest first) -->
            <div class="relative flex flex-col md:flex-row items-center justify-between group">
              <div class="absolute left-6 md:left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-lg z-20 transition-transform group-hover:scale-125">
                <div class="w-5 h-5 rounded-full bg-surface-variant flex items-center justify-center"><span class="material-symbols-outlined text-primary text-[14px]">flag</span></div>
              </div>
              <div class="ml-16 md:ml-0 md:w-[45%] w-[calc(100%-4rem)]">
                <div class="bg-surface-container p-space-lg rounded-xl shadow-xl hover:bg-surface-container-high transition-all relative overflow-hidden">
                  <div class="flex items-center justify-between mb-space-xs">
                    <span class="font-telemetry-num text-headline-md text-on-surface-variant italic font-black">NEXT</span>
                    <span class="font-label-xs text-label-xs uppercase px-2 py-0.5 bg-surface-container-lowest text-primary rounded font-bold">Next Step</span>
                  </div>
                  <h3 class="font-headline-md text-headline-md uppercase italic font-extrabold text-on-surface mb-space-xs">Next Destination: British Supersport</h3>
                  <div class="font-label-md text-label-md text-primary uppercase font-bold tracking-wider mb-space-sm">Final Destination: The British Superbike Championship</div>
                  <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md">The next step is British Supersport. The final destination is British Superbikes, and one day the dream race: a Yamaha R1 at Mugello. Getting there takes results, hard work and the right partners.</p>
                  <div class="flex flex-wrap gap-2 pt-space-xs">
                    <span class="bg-surface-container-lowest px-space-sm py-1 rounded font-label-xs text-label-xs text-on-surface font-semibold">🎯 Next: British Supersport</span>
                    <span class="bg-surface-container-lowest px-space-sm py-1 rounded font-label-xs text-label-xs text-on-surface font-semibold">🏆 Final: British Superbikes</span>
                    <span class="bg-surface-container-lowest px-space-sm py-1 rounded font-label-xs text-label-xs text-on-surface font-semibold">🏁 Dream Race: Yamaha R1 at Mugello</span>
                  </div>
                </div>
              </div>
              <div class="hidden md:block md:w-[45%] pl-space-lg text-left">
                <div class="p-space-lg bg-surface-container-low rounded-xl max-w-md shadow-md space-y-space-xs">
                  <div class="flex items-center justify-between text-on-surface-variant">
                    <span class="font-label-xs text-label-xs uppercase tracking-widest">Roadmap Status</span>
                    <span class="font-telemetry-num text-body-sm text-primary-container font-black">STAGE 04/05</span>
                  </div>
                  <div class="space-y-space-xs pt-space-xs">
                    {roadmap.map((r) => (
                      <div>
                        <div class="flex justify-between font-label-xs text-label-xs mb-1">
                          <span class="text-on-surface">{r.label}</span>
                          <span class:list={['font-bold', r.state === 'goal' ? 'text-on-surface-variant' : 'text-primary']}>{r.state === 'done' ? 'Done' : r.state === 'now' ? 'Now' : 'Goal'}</span>
                        </div>
                        <div class="w-full h-1.5 bg-surface-container-high rounded-full overflow-hidden">
                          <div class:list={['h-full', r.state === 'done' ? 'bg-primary-container w-full' : r.state === 'now' ? 'bg-primary w-1/2' : 'w-0']}></div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {entries.map((e, i) => {
              const left = i % 2 === 1;
              return (
                <div class:list={['relative flex flex-col items-center justify-between group', left ? 'md:flex-row' : 'md:flex-row-reverse']}>
                  {e.node === 'active'
                    ? <div class="absolute left-6 md:left-1/2 -translate-x-1/2 w-12 h-12 rounded-full bg-primary-container flex items-center justify-center shadow-xl z-20 ring-4 ring-primary-container/20"><span class="material-symbols-outlined text-on-primary-container text-[20px]">two_wheeler</span></div>
                    : <div class="absolute left-6 md:left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center shadow-lg z-20 transition-transform group-hover:scale-125">
                        {e.node === 'live' && <div class="w-5 h-5 rounded-full bg-primary-container flex items-center justify-center"><div class="w-2 h-2 rounded-full bg-on-primary-container animate-ping"></div></div>}
                        {e.node === 'dim' && <div class="w-5 h-5 rounded-full bg-surface-bright flex items-center justify-center"><div class="w-2 h-2 rounded-full bg-primary"></div></div>}
                        {e.node === 'trophy' && <div class="w-6 h-6 rounded-full bg-primary-container flex items-center justify-center"><span class="material-symbols-outlined text-on-primary-container text-[14px]">emoji_events</span></div>}
                        {e.node === 'solid' && <div class="w-5 h-5 rounded-full bg-primary-container flex items-center justify-center"><div class="w-2 h-2 rounded-full bg-on-primary-container"></div></div>}
                      </div>}
                  <div class="ml-16 md:ml-0 md:w-[45%] w-[calc(100%-4rem)]">
                    <div class="bg-surface-container p-space-lg rounded-xl shadow-xl hover:bg-surface-container-high transition-all relative overflow-hidden">
                      {e.champion && <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary-container via-primary to-primary-container"></div>}
                      <div class="flex flex-wrap items-center justify-between gap-2 mb-space-xs">
                        {e.active
                          ? <div class="flex items-center gap-space-xs">
                              <span class="font-telemetry-num text-headline-md text-primary-container italic font-black">{e.year}</span>
                              <span class="px-2 py-0.5 bg-primary-container text-on-primary-container font-label-xs text-label-xs uppercase font-black tracking-widest rounded animate-pulse">Active Campaign</span>
                            </div>
                          : <span class="font-telemetry-num text-headline-md text-primary-container italic font-black">{e.year}</span>}
                        <span class:list={['font-label-xs text-label-xs uppercase px-2 py-0.5 rounded', e.champion ? 'bg-primary-container text-on-primary-container font-bold' : e.active ? 'bg-surface-container-lowest text-primary font-bold' : 'bg-surface-container-lowest text-on-surface-variant']}>{e.tag}</span>
                      </div>
                      <h3 class="font-headline-md text-headline-md uppercase italic font-extrabold text-on-surface mb-space-xs">{e.title}</h3>
                      <div class="font-label-md text-label-md text-primary uppercase font-bold tracking-wider mb-space-sm">{e.machine}</div>
                      <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md">{e.body}</p>
                      <div class="flex flex-wrap gap-2 pt-space-xs">
                        {e.pills.map((p, k) => <span class:list={['bg-surface-container-lowest px-space-sm py-1 rounded font-label-xs text-label-xs', e.active && k === 0 ? 'text-primary font-bold' : 'text-on-surface font-semibold']}>{p}</span>)}
                      </div>
                    </div>
                  </div>
                  <div class:list={['hidden md:block md:w-[45%]', left ? 'pl-space-lg text-left' : 'pr-space-lg']}>
                    <div class:list={['relative rounded-lg overflow-hidden shadow-lg aspect-video bg-surface-container-low max-w-md', { 'ml-auto': !left }]}>
                      {e.image
                        ? <img class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-opacity" src={e.image.src} alt={e.image.alt} loading="lazy" decoding="async" />
                        : <div class="w-full h-full flex flex-col items-center justify-center gap-space-xs bg-[repeating-linear-gradient(-60deg,rgba(255,255,255,0.025)_0_2px,transparent_2px_14px)] text-on-surface-variant/60">
                            <span class="material-symbols-outlined text-[28px]">photo_camera</span>
                            <span class="font-label-xs text-label-xs uppercase tracking-widest">{e.year} photo coming soon</span>
                          </div>}
                      <div class:list={['absolute bottom-2 px-2 py-1 bg-surface-container-lowest/80 backdrop-blur rounded font-label-xs text-label-xs uppercase', left ? 'left-2' : 'right-2', e.active ? 'text-primary font-black' : 'text-on-surface']}>{e.caption}</div>
                    </div>
                  </div>
                </div>
              );
            })}

          </div>
        </div>
      </div>
    </section>

    <!-- RACING PHILOSOPHY -->
    <section class="w-full py-space-xl bg-surface-container-low">
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter items-stretch">
          {[
            { icon: 'precision_manufacturing', title: 'Race Engineering Mindset', body: 'Training as a race technician at Silverstone Motorsport College means Lewis understands what the bike is doing underneath him, and can turn that feeling into clear feedback for the crew.', foot: 'Chassis // Feedback First' },
            { icon: 'fitness_center', title: 'Training Discipline', body: 'Five days a week in the gym, all year round. Race fitness is built long before the lights go out, and Lewis treats preparation as part of the job.', foot: 'Discipline // Zero Compromise' },
            { icon: 'verified', title: 'Backed by Triumph', body: 'Consistent wins and podiums, and 3rd in the 2024 championship, caught the attention of Triumph. Racing with Triumph is the reward, and the platform for what comes next.', foot: 'Triumph // #32 Racing UK' },
          ].map((p) => (
            <div class="bg-surface-container p-space-lg rounded-xl shadow-lg flex flex-col justify-between">
              <div>
                <div class="w-10 h-10 rounded bg-surface-container-high flex items-center justify-center text-primary-container mb-space-md"><span class="material-symbols-outlined text-[24px]">{p.icon}</span></div>
                <h4 class="font-headline-sm text-headline-sm uppercase italic font-bold text-on-surface mb-space-xs">{p.title}</h4>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{p.body}</p>
              </div>
              <div class="mt-space-md pt-space-xs font-label-xs text-label-xs text-on-surface-variant uppercase tracking-widest">{p.foot}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PARTNERSHIP CTA -->
    <section class="w-full py-space-xl lg:py-margin-lg bg-surface-container-lowest relative overflow-hidden">
      <div class="absolute -right-20 top-0 bottom-0 w-80 bg-primary-container/10 -skew-x-12 pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-margin-sm lg:px-margin relative z-10">
        <div class="bg-gradient-to-r from-surface-container to-surface-container-high rounded-2xl p-space-lg lg:p-space-xl shadow-2xl relative overflow-hidden">
          <div class="pointer-events-none select-none absolute right-4 -bottom-10 opacity-5 font-display-hero text-[180px] lg:text-[240px] text-on-surface font-black italic tracking-tighter" aria-hidden="true">#32</div>
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter items-center relative z-10">
            <div class="lg:col-span-8 space-y-space-sm">
              <div class="inline-flex items-center gap-space-xs px-space-sm py-1 bg-primary-container text-on-primary-container rounded font-label-xs text-label-xs uppercase tracking-widest font-black italic">Commercial Opportunities // Next Season</div>
              <h2 class="font-display-hero text-headline-lg-mobile sm:text-headline-lg lg:text-headline-xl uppercase italic font-black text-on-surface tracking-tight leading-none">PARTNER WITH LEWIS FOR THE NEXT CHAPTER</h2>
              <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl leading-relaxed">Align your brand with one of Britain's rising motorcycle road racing talents. High-visibility branding on the bike and leathers, race weekend hospitality and content made for your channels.</p>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-sm pt-space-xs">
                {['Bike & Leathers Livery', 'Paddock Hospitality', 'Content for Your Brand'].map((perk) => (
