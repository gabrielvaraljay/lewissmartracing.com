            <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-space-sm justify-center">
              <a class="w-full inline-flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary-container hover:bg-primary text-on-primary-container font-headline-sm text-headline-sm uppercase italic tracking-wider transition-all shadow-lg rounded hover:scale-[1.02] active:scale-[0.98]" href={site.sponsorDeck ?? '/contact/?topic=sponsorship'} download={site.sponsorDeck ? true : undefined}>
